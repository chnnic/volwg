#!/usr/bin/env bash
set -Eeuo pipefail

REPO_RAW_URL="https://raw.githubusercontent.com/chnnic/volwg/main"
BUILTIN_VERSION="1.4.19"

find_lib_dir() {
  local launcher_dir user_data_dir
  launcher_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  user_data_dir="${XDG_DATA_HOME:-${HOME:?}/.local/share}/volwg"

  if [[ -f "$launcher_dir/wg-home-deploy.sh" ]]; then
    printf '%s' "$launcher_dir"
  elif [[ -f /usr/lib/volwg/wg-home-deploy.sh ]]; then
    printf '%s' /usr/lib/volwg
  elif [[ -f /usr/local/lib/volwg/wg-home-deploy.sh ]]; then
    printf '%s' /usr/local/lib/volwg
  elif [[ -f "$user_data_dir/wg-home-deploy.sh" ]]; then
    printf '%s' "$user_data_dir"
  else
    echo "错误：找不到 VolWG 程序文件，请重新运行一键安装命令。" >&2
    exit 1
  fi
}

LIB_DIR="$(find_lib_dir)"

current_version() {
  if [[ -s "$LIB_DIR/VERSION" ]]; then
    tr -d '[:space:]' <"$LIB_DIR/VERSION"
  else
    printf '%s' "$BUILTIN_VERSION"
  fi
}

fetch_text() {
  local url="$1"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --retry 3 "$url"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- "$url"
  else
    echo "错误：在线升级需要 curl 或 wget。" >&2
    return 1
  fi
}

latest_version() {
  local release_json latest=""
  if release_json="$(fetch_text 'https://api.github.com/repos/chnnic/volwg/releases/latest' 2>/dev/null)"; then
    latest="$(printf '%s\n' "$release_json" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v\([^"]*\)".*/\1/p' | head -n 1)"
  fi
  if [[ ! "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    latest="$(fetch_text "$REPO_RAW_URL/VERSION?cache=$(date +%s)" 2>/dev/null || true)"
    latest="${latest//[[:space:]]/}"
  fi
  [[ "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  printf '%s' "$latest"
}

clear_screen() {
  [[ -t 1 ]] || return 0
  if command -v clear >/dev/null 2>&1; then
    clear
  else
    printf '\033[2J\033[H'
  fi
}

pause_screen() {
  [[ -t 0 ]] || return 0
  echo
  read -r -p "按 Enter 返回菜单..." _
}

print_header() {
  cat <<'EOF'
 ██╗   ██╗ ██████╗ ██╗     ██╗    ██╗ ██████╗
 ██║   ██║██╔═══██╗██║     ██║    ██║██╔════╝
 ██║   ██║██║   ██║██║     ██║ █╗ ██║██║  ███╗
 ╚██╗ ██╔╝██║   ██║██║     ██║███╗██║██║   ██║
  ╚████╔╝ ╚██████╔╝███████╗╚███╔███╔╝╚██████╔╝
   ╚═══╝   ╚═════╝ ╚══════╝ ╚══╝╚══╝  ╚═════╝
EOF
  echo " VolWG v$(current_version) · 多线路家宽落地"
  echo "============================================================"
}

local_node_count() {
  local file id count
  local -a files manual_files
  shopt -s nullglob
  files=()
  manual_files=()
  files+=(/etc/wg-home-exit/nodes/*.conf)
  manual_files+=(/etc/wg-home-exit/manual/*.conf)
  count="${#files[@]}"
  if ((${#manual_files[@]} > 0)); then
    for file in "${manual_files[@]}"; do
      id="$(sed -n 's/^NODE_ID=//p' "$file" | head -n 1)"
      [[ -f "/etc/wg-home-exit/nodes/$id.conf" ]] || ((count++)) || true
    done
  fi
  printf '%s' "$count"
}

print_menu_title() {
  local title="$1" count
  count="$(local_node_count)"
  echo " 菜单：$title"
  if ((count > 0)); then
    echo " 本机已登记线路：$count 条"
  fi
  echo "------------------------------------------------------------"
  echo
}

show_version() {
  local latest=""
  echo "当前版本：v$(current_version)"
  if latest="$(latest_version)"; then
    echo "在线版本：v$latest"
    if [[ "$latest" == "$(current_version)" ]]; then
      echo "状态：已是最新版本"
    else
      echo "状态：发现可用更新"
    fi
  else
    echo "在线版本：检查失败"
  fi
}

online_update() {
  local current latest installer launcher_path launcher_dir
  current="$(current_version)"
  echo "正在检查 GitHub 更新..."
  latest="$(latest_version)" || {
    echo "错误：无法获取在线版本。" >&2
    return 1
  }
  [[ "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
    echo "错误：在线版本号无效：$latest" >&2
    return 1
  }
  echo "当前版本：v$current"
  echo "在线版本：v$latest"
  if [[ "$current" == "$latest" ]]; then
    echo "VolWG 已是最新版本。"
    return 0
  fi

  installer="$(fetch_text "https://raw.githubusercontent.com/chnnic/volwg/v$latest/install.sh")" || return 1
  launcher_path="$(command -v volwg 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
  launcher_dir="$(dirname -- "$launcher_path")"
  echo "正在升级 VolWG..."
  if [[ -w "$LIB_DIR" && -w "$launcher_dir" ]]; then
    VOLWG_REF="v$latest" VOLWG_NO_LAUNCH=1 bash -c "$installer"
  elif command -v sudo >/dev/null 2>&1; then
    sudo env VOLWG_REF="v$latest" VOLWG_NO_LAUNCH=1 bash -c "$installer"
  else
    echo "错误：安装目录需要 root 权限，请使用 sudo volwg update。" >&2
    return 1
  fi
  echo "升级完成：v$current → v$latest"
  echo "重新输入 volwg 即可使用新版本。"
}

remote_manager() {
  local target port identity
  local -a ssh_args
  read -r -p "VPS SSH，例如 root@203.0.113.10：" target
  [[ -n "$target" ]] || { echo "VPS SSH 不能为空。"; return 1; }
  read -r -p "VPS SSH 端口 [22]：" port
  port="${port:-22}"
  read -r -p "SSH 私钥路径（留空使用 ssh-agent/~/.ssh/config）：" identity
  ssh_args=(-o ConnectTimeout=12 -o StrictHostKeyChecking=accept-new -p "$port")
  if [[ -n "$identity" ]]; then
    ssh_args+=(-i "$identity" -o IdentitiesOnly=yes)
  fi
  ssh -t "${ssh_args[@]}" "$target" "volwg manager"
}

confirm_wireguard_only() {
  local role_label="$1" answer
  clear_screen
  print_header
  print_menu_title "仅 WireGuard 手动配对"
  echo "当前选择：$role_label"
  echo
  echo "此模式只会："
  echo "  - 创建独立 WireGuard 接口、密钥和隧道配置"
  echo "  - 不安装 ss-rust"
  echo "  - 不安装或配置 Xray Core"
  echo "  - 不生成 SS 链接，也不创建公网 SS 转发"
  echo
  echo "需要完整家宽落地线路，请返回选择："
  echo "  1) 双 SSH 窗口完整部署（推荐）"
  echo
  read -r -p "输入 1 继续仅 WireGuard，输入 0 返回 [0]：" answer
  [[ "$answer" == "1" ]]
}

deployment_menu() {
  local choice pair_role
  while true; do
    clear_screen
    print_header
    print_menu_title "主菜单 > 新建线路与配对"
    echo "  1) 双 SSH 窗口完整部署（推荐）"
    echo "     家宽机主动连接 VPS；无需公网 IP，也无需两端互相 SSH"
    echo "  2) 仅 WireGuard：当前机器是 VPS"
    echo "  3) 仅 WireGuard：当前机器是家宽机"
    echo "  4) 控制端远程全自动部署"
    echo "     仅适合当前控制机能分别 SSH 到 VPS 和家宽机"
    echo "  0) 返回主菜单    q) 退出"
    read -r -p "请选择 [0-4/q]：" choice
    case "$choice" in
      1)
        clear_screen
        print_header
        print_menu_title "主菜单 > 新建线路与配对 > 双窗口完整部署"
        echo "请在 VPS 和家宽机两个 SSH 窗口都安装 VolWG。"
        echo "两端各自配置本机，只交换 WireGuard 公钥和 SS2022 密钥。"
        echo
        echo "  1) 当前窗口是公网/优化 VPS"
        echo "  2) 当前窗口是家宽机"
        echo "  0) 返回"
        read -r -p "请选择 [0-2]：" pair_role
        case "$pair_role" in
          1) bash "$LIB_DIR/wg-home-key-wizard.sh" --full --role vps; pause_screen ;;
          2) bash "$LIB_DIR/wg-home-key-wizard.sh" --full --role home; pause_screen ;;
          0) ;;
          *) echo "选择无效。"; pause_screen ;;
        esac
        ;;
      2)
        if confirm_wireguard_only "VPS"; then
          bash "$LIB_DIR/wg-home-key-wizard.sh" --role vps
          pause_screen
        fi
        ;;
      3)
        if confirm_wireguard_only "家宽机"; then
          bash "$LIB_DIR/wg-home-key-wizard.sh" --role home
          pause_screen
        fi
        ;;
      4) bash "$LIB_DIR/wg-home-deploy.sh" --guided; pause_screen ;;
      0) return ;;
      q|Q) clear_screen; exit 0 ;;
      *) echo "选择无效。"; pause_screen ;;
    esac
  done
}

management_menu() {
  local choice
  while true; do
    clear_screen
    print_header
    print_menu_title "主菜单 > 线路管理"
    echo "  1) 打开本机线路管理"
    echo "  2) 快速查看全部 SS 链接"
    echo "  3) 快速查看线路状态"
    echo "  4) 诊断指定线路"
    echo "  5) 通过 WireGuard 进入家宽机 SSH"
    echo "  6) 连接远程 VPS 管理"
    echo "  7) 按序号删除本机线路"
    echo "  0) 返回主菜单    q) 退出"
    read -r -p "请选择 [0-7/q]：" choice
    case "$choice" in
      1) bash "$LIB_DIR/wg-home-manager.sh" menu ;;
      2) clear_screen; bash "$LIB_DIR/wg-home-manager.sh" links; pause_screen ;;
      3) clear_screen; bash "$LIB_DIR/wg-home-manager.sh" status; pause_screen ;;
      4) bash "$LIB_DIR/wg-home-manager.sh" diagnose-menu; pause_screen ;;
      5) bash "$LIB_DIR/wg-home-manager.sh" ssh-menu; pause_screen ;;
      6) remote_manager; pause_screen ;;
      7) bash "$LIB_DIR/wg-home-manager.sh" delete-menu; pause_screen ;;
      0) return ;;
      q|Q) clear_screen; exit 0 ;;
      *) echo "选择无效。"; pause_screen ;;
    esac
  done
}

system_menu() {
  local choice
  while true; do
    clear_screen
    print_header
    print_menu_title "主菜单 > 系统维护"
    echo "  1) 检查并在线升级"
    echo "  2) 查看版本"
    echo "  3) 查看命令帮助"
    echo "  4) 清空本机旧线路与配置记录"
    echo "  0) 返回主菜单    q) 退出"
    read -r -p "请选择 [0-4/q]：" choice
    case "$choice" in
      1) clear_screen; online_update; pause_screen ;;
      2) clear_screen; show_version; pause_screen ;;
      3) clear_screen; show_help; pause_screen ;;
      4) clear_screen; bash "$LIB_DIR/wg-home-purge.sh"; pause_screen ;;
      0) return ;;
      q|Q) clear_screen; exit 0 ;;
      *) echo "选择无效。"; pause_screen ;;
    esac
  done
}

show_help() {
  cat <<'EOF'
VolWG 命令：
  volwg                    打开多级引导界面
  volwg pair [参数]        双 SSH 窗口完整部署；在两端各自执行
  volwg deploy [参数]      控制端远程部署；要求能 SSH 到两端
  volwg manager            打开本机线路管理界面
  volwg manager links      查看本机保存的全部 SS 链接
  volwg diagnose ID        诊断指定线路的 WG、SS、转发和 SSH
  volwg ssh ID             从 VPS 通过 WireGuard 进入家宽机 SSH
  volwg key [参数]         仅 WireGuard：双 SSH 窗口公钥向导
  volwg remove --node ID   删除本机指定线路并归档配置
  volwg purge              清空本机全部 VolWG 线路和旧记录（保留程序）
  volwg version            查看本地和在线版本
  volwg update             在线升级
  volwg help               显示此帮助
EOF
}

main_menu() {
  local choice
  while true; do
    clear_screen
    print_header
    print_menu_title "主菜单"
    echo "  1) 线路管理"
    echo "  2) 新建线路与配对"
    echo "  3) 系统维护与在线升级"
    echo "  0) 退出    q) 退出"
    read -r -p "请选择 [0-3/q]：" choice
    case "$choice" in
      1) management_menu ;;
      2) deployment_menu ;;
      3) system_menu ;;
      0|q|Q) clear_screen; return ;;
      *) echo "选择无效。"; pause_screen ;;
    esac
  done
}

subcommand="${1:-}"
case "$subcommand" in
  "") main_menu ;;
  manager)
    shift
    if (($# == 0)); then
      set -- menu
    fi
    exec bash "$LIB_DIR/wg-home-manager.sh" "$@"
    ;;
  diagnose) shift; exec bash "$LIB_DIR/wg-home-manager.sh" diagnose "$@" ;;
  ssh) shift; exec bash "$LIB_DIR/wg-home-manager.sh" ssh "$@" ;;
  key) shift; exec bash "$LIB_DIR/wg-home-key-wizard.sh" "$@" ;;
  pair) shift; exec bash "$LIB_DIR/wg-home-key-wizard.sh" --full "$@" ;;
  remove|delete) shift; exec bash "$LIB_DIR/wg-home-remove.sh" "$@" ;;
  purge|clean) shift; exec bash "$LIB_DIR/wg-home-purge.sh" "$@" ;;
  deploy) shift; exec bash "$LIB_DIR/wg-home-deploy.sh" "$@" ;;
  version) show_version ;;
  update|upgrade) online_update ;;
  help|-h|--help) show_help ;;
  *) exec bash "$LIB_DIR/wg-home-deploy.sh" "$@" ;;
esac
